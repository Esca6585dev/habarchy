# docker compose -f deploy/docker-compose.yml --env-file deploy/.env up -d
# Generate secrets:  openssl rand -hex 32   /   docker compose run --rm api api -genkey
POSTGRES_PASSWORD=change-me
HABARCHY_JWT_SECRET=change-me-to-a-random-string-of-at-least-32-chars
HABARCHY_MASTER_KEY=                     # 64 hex chars (api -genkey)
HABARCHY_PUBLIC_URL=http://localhost     # public address of nginx (https://habarchy.example.tm in production)
HABARCHY_SECURE_COOKIES=false            # true behind HTTPS
HTTP_PORT=80
HTTPS_PORT=443
HABARCHY_TAG=latest                      # image tag (ghcr.io) or build locally with --build

# Optional tuning (see backend/.env.example for everything)
HABARCHY_WORKER_CONCURRENCY=20
HABARCHY_API_RATE_PER_SEC=50
HABARCHY_WEBHOOK_ALLOW_PRIVATE=false

# First admin (used by: docker compose run --rm api api -create-admin   or   api -seed)
HABARCHY_ADMIN_EMAIL=admin@example.tm
HABARCHY_ADMIN_PASSWORD=change-me-please
HABARCHY_ADMIN_NAME=Admin
